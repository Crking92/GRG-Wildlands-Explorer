{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glass Root Garden property snapshot v1",
  "description": "Structural schema for current export. Future record types reserved in the section envelopes; scientific and cross-property validation additionally handled by exporter.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "format": {
      "const": "grg_property_snapshot"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "privacy": {
      "type": "object",
      "properties": {
        "classification": {
          "const": "private_local_client_record"
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "contains_coordinates": {
          "const": true
        }
      },
      "required": [
        "classification",
        "storage",
        "contains_coordinates"
      ]
    },
    "property": {
      "type": "object",
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "$ref": "#/$defs/polygonFeature"
        },
        "area_acres": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "perimeter_ft": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_id": {
          "enum": [
            "boundary_drawn",
            "hays_parcels"
          ]
        },
        "parcel_metadata": {
          "type": [
            "object",
            "null"
          ]
        },
        "boundary_recorded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "const": "not_field_verified"
        }
      },
      "required": [
        "property_id",
        "boundary",
        "area_acres",
        "perimeter_ft",
        "source_id",
        "parcel_metadata",
        "boundary_recorded_at",
        "method",
        "verification_status"
      ]
    },
    "source_registry": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "vintage": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "provider",
          "dataset",
          "url",
          "vintage",
          "limitations"
        ]
      }
    },
    "map_display_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "habitat_composition": {
          "$ref": "#/$defs/section"
        },
        "soil_map": {
          "$ref": "#/$defs/section"
        },
        "tree_canopy": {
          "$ref": "#/$defs/section"
        },
        "land_cover": {
          "$ref": "#/$defs/section"
        },
        "terrain": {
          "$ref": "#/$defs/section"
        },
        "hydrology": {
          "$ref": "#/$defs/section"
        },
        "historical_imagery": {
          "$ref": "#/$defs/section"
        },
        "point_estimates": {
          "$ref": "#/$defs/section"
        },
        "impervious_surfaces": {
          "$ref": "#/$defs/section"
        },
        "vegetation_height": {
          "$ref": "#/$defs/section"
        },
        "geology": {
          "$ref": "#/$defs/section"
        },
        "groundwater": {
          "type": "object",
          "properties": {
            "major": {
              "$ref": "#/$defs/section"
            },
            "minor": {
              "$ref": "#/$defs/section"
            },
            "zones": {
              "$ref": "#/$defs/section"
            }
          },
          "required": [
            "major",
            "minor",
            "zones"
          ]
        },
        "climate": {
          "$ref": "#/$defs/section"
        },
        "rainfall_history": {
          "$ref": "#/$defs/section"
        },
        "temperature_history": {
          "$ref": "#/$defs/section"
        },
        "drought": {
          "$ref": "#/$defs/section"
        },
        "solar": {
          "$ref": "#/$defs/section"
        },
        "et0": {
          "$ref": "#/$defs/section"
        },
        "et_history": {
          "$ref": "#/$defs/section"
        },
        "terrain_solar": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "habitat_composition",
        "soil_map",
        "tree_canopy",
        "land_cover",
        "terrain",
        "hydrology",
        "historical_imagery",
        "point_estimates"
      ]
    },
    "maps": {
      "type": "object",
      "properties": {
        "existing_conditions": {
          "$ref": "#/$defs/section"
        },
        "proposed_management": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "existing_conditions",
        "proposed_management"
      ]
    },
    "field_observations": {
      "type": "object",
      "properties": {
        "plant_inventory": {
          "$ref": "#/$defs/section"
        },
        "soil_sampling": {
          "$ref": "#/$defs/section"
        },
        "laboratory_results": {
          "$ref": "#/$defs/section"
        },
        "wildlife": {
          "$ref": "#/$defs/section"
        },
        "photographs": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "plant_inventory",
        "soil_sampling",
        "laboratory_results",
        "wildlife",
        "photographs"
      ]
    },
    "regional_evidence": {
      "type": "object",
      "properties": {
        "nativity": {
          "$ref": "#/$defs/section"
        },
        "biodiversity": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "nativity",
        "biodiversity"
      ]
    },
    "potential_relationships": {
      "type": "object",
      "properties": {
        "bees": {
          "$ref": "#/$defs/section"
        },
        "lepidoptera": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "bees",
        "lepidoptera"
      ]
    },
    "recommendations": {
      "type": "object",
      "properties": {
        "native_communities": {
          "$ref": "#/$defs/section"
        },
        "restoration_objectives": {
          "$ref": "#/$defs/section"
        },
        "management": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "native_communities",
        "restoration_objectives",
        "management"
      ]
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "permanent_points": {
          "$ref": "#/$defs/section"
        },
        "history": {
          "$ref": "#/$defs/section"
        }
      },
      "required": [
        "permanent_points",
        "history"
      ]
    },
    "report_templates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "const": "not_implemented"
          }
        },
        "required": [
          "id",
          "title",
          "inputs",
          "status"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "snapshot_id",
    "exported_at",
    "app_version",
    "privacy",
    "property",
    "source_registry",
    "map_display_context",
    "environment",
    "maps",
    "field_observations",
    "regional_evidence",
    "potential_relationships",
    "recommendations",
    "monitoring",
    "report_templates",
    "limitations"
  ],
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "retrieved",
            "estimated",
            "field_verified",
            "partial_coverage",
            "unavailable",
            "no_data",
            "not_analyzed",
            "not_surveyed",
            "not_measured",
            "not_implemented",
            "not_field_verified",
            "proposed",
            "predicted",
            "historical",
            "in_progress",
            "canceled"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "label",
        "records",
        "detail"
      ]
    },
    "polygonFeature": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Feature"
        },
        "geometry": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array",
              "minItems": 1
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ]
    }
  }
}
